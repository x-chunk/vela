# Example configuration for Vela — not a supported deployment.
# Scenario: fs-accel
# Requires: matching docker and proxy examples
# Replace: store.example.com, certificate paths, /srv/vela, upstream address.
# You are responsible for securing and maintaining your reverse proxy.

# CHANGE ME: public origin; required, with no path or trailing slash.
VELA_PUBLIC_URL=https://store.example.com
# Container paths; mount the host data directory at /data.
VELA_LISTEN=:8080
VELA_DATA_DIR=/data
# Only trust addresses belonging to your reverse proxy.
VELA_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# CHANGE ME if using a host proxy with Docker bridge networking: inspect
# your actual gateway and add that single address. Do not trust the whole subnet.
# Example Docker bridge gateway (not universal):
#VELA_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.17.0.1/32
# --network host on Linux lets a loopback proxy use the default instead.
# Keep the upload limit in sync with nginx client_max_body_size.
VELA_MAX_UPLOAD=2GiB
VELA_MAX_CREATE=1MiB
VELA_MAX_CONCURRENT_UPLOADS=4
# Lifetimes accept durations such as 24h, 7d, or 30d.
VELA_LINK_DEFAULT_TTL=24h
VELA_LINK_MAX_TTL=30d
VELA_LINK_RETENTION=7d
VELA_TRASH_RETENTION=14d
VELA_JANITOR_INTERVAL=24h
# public, unlisted, or private. Unlisted URLs are accessible without a key.
VELA_DEFAULT_VISIBILITY=unlisted
# robots.txt: allow or deny.
VELA_ROBOTS=deny
# Root DB policy overrides this default. This does not restrict file access.
VELA_ROOT_INDEX=on
VELA_SITE_TITLE=Vela
# Optional: mount theme overrides read-only at this container path.
VELA_THEME_DIR=
# debug, info, warn, error; json or text.
VELA_LOG_LEVEL=info
VELA_LOG_FORMAT=json

VELA_STORAGE=fs
# Must match nginx internal locations when nonempty. Empty selects direct delivery.
VELA_ACCEL_PREFIX=/_blobs/
