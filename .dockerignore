# Only the Go sources (with embedded theme and migrations) are needed to
# build velad; keep the build context small and free of local data.
.git
.github
bin
dist
.dev-data
*.test
*.out
.idea
.vscode
docs
examples
README.md
AGENTS.md
REVIEW.md

CONTRIBUTING.md
SECURITY.md
CHANGELOG.md

# Operator credentials must never enter the build context.
**/*.env
**/.env
**/.env.*
!**/*.env.example
!**/.env.example
