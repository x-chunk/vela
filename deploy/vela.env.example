# Environment for the velad container. Copy to /etc/vela/vela.env, chmod 600,
# and pass with: docker run --env-file /etc/vela/vela.env ...
# Core server settings also have flags (see "velad serve --help").
# Storage settings and credentials are read only from environment variables.

# Required: the public origin, without a trailing slash.
VELA_PUBLIC_URL=https://store.xchunk.org

# Listen address inside the container. Publish it on loopback only:
#   docker run -p 127.0.0.1:8080:8080 ...
#VELA_LISTEN=:8080

# Data directory inside the container (bind-mount /srv/vela here).
#VELA_DATA_DIR=/data

# nginx X-Accel-Redirect prefix; must match "location /_blobs/" in
# deploy/nginx/vela.conf. Empty makes velad serve file bytes itself.
#VELA_ACCEL_PREFIX=/_blobs/

# Proxies allowed to set X-Real-IP, X-Forwarded-For and X-Request-ID. With
# -p 127.0.0.1:8080:8080, nginx reaches the container through the docker
# bridge gateway (check with: docker network inspect bridge | grep Gateway).
#VELA_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.17.0.1/32

# Size limits. Keep VELA_MAX_UPLOAD in sync with client_max_body_size.
#VELA_MAX_UPLOAD=2GiB
#VELA_MAX_CREATE=1MiB

# Signed links: default and maximum lifetime, and how long expired link
# records stay visible in "vela links ls --all".
#VELA_LINK_DEFAULT_TTL=24h
#VELA_LINK_MAX_TTL=30d
#VELA_LINK_RETENTION=7d

# How long deleted files stay in the trash, and how often the janitor runs.
#VELA_TRASH_RETENTION=14d
#VELA_JANITOR_INTERVAL=24h

# Visibility of new files when the client sets none: public, unlisted or
# private. Unlisted files are reachable by anyone who knows the URL.
#VELA_DEFAULT_VISIBILITY=unlisted

# robots.txt: deny (Disallow: /) or allow (index the public listing).
#VELA_ROBOTS=deny

# HTML index.
#VELA_SITE_TITLE=store.xchunk.org
# Directory (inside the container) with theme overrides; mount it read-only.
#VELA_THEME_DIR=

# Logging: debug, info, warn or error; json or text.
#VELA_LOG_LEVEL=info
#VELA_LOG_FORMAT=json

# Storage backend: fs (default) or r2. One image supports both.
#VELA_STORAGE=fs
#VELA_MAX_CONCURRENT_UPLOADS=4

# Required for r2. Also set VELA_ACCEL_PREFIX= (an empty value).
#VELA_R2_ACCOUNT_ID=
#VELA_R2_BUCKET=vela-store
#VELA_R2_ACCESS_KEY_ID=
#VELA_R2_SECRET_ACCESS_KEY=
# Override for EU jurisdiction or a local S3-compatible test service.
#VELA_R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
#VELA_R2_PREFIX=blobs/
#VELA_R2_DELIVERY=proxy
#VELA_R2_PRESIGN_TTL=5m
#VELA_R2_PART_SIZE=8MiB
#VELA_R2_UPLOAD_CONCURRENCY=2
#VELA_R2_PATH_STYLE=true
